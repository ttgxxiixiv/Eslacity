    {"id": "airport.avere_i_nervi_a_fior_di_pelle", "es": "avere i nervi a fior di pelle", "ru": "быть на нервах", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "informal", "literal": "иметь нервы на поверхности кожи", "example": {"es": "Mia madre ha i nervi a fior di pelle ogni volta che vola.", "ru": "Мама на нервах каждый раз, когда летит."}},
