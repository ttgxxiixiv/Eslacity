    {"id": "school.fare_scena_muta", "es": "fare scena muta", "ru": "молчать на экзамене", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "neutral", "literal": "устроить немую сцену", "example": {"es": "All'interrogazione ho fatto scena muta.", "ru": "На устном опросе я не смог сказать ни слова."}},
