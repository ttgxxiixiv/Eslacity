    {"id": "school.sgobbare_sui_libri", "es": "sgobbare sui libri", "ru": "зубрить", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "collocation", "register": "informal", "example": {"es": "Se vuoi passare, devi sgobbare sui libri.", "ru": "Хочешь сдать — придётся зубрить."}},
