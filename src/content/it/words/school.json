    {"id": "school.fare_l_appello", "es": "fare l'appello", "ru": "делать перекличку", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "collocation", "register": "neutral", "example": {"es": "Il professore fa l'appello alle nove.", "ru": "Учитель делает перекличку в девять."}},
