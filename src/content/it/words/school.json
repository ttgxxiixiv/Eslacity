    {"id": "school.sapere_a_menadito", "es": "sapere a menadito", "ru": "знать назубок", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "neutral", "literal": "знать как свои пять пальцев", "example": {"es": "Sa le capitali a menadito.", "ru": "Он знает столицы назубок."}},
