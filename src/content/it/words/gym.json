    {"id": "gym.squat", "es": "lo squat", "ru": "приседание", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Fai tre serie da quindici squat.", "ru": "Сделай три подхода по пятнадцать приседаний."}},
