    {"id": "gym.metabolismo", "es": "il metabolismo", "ru": "обмен веществ", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Con l'età il metabolismo rallenta.", "ru": "С возрастом обмен веществ замедляется."}},
    {"id": "gym.bruciare_calorie", "es": "bruciare calorie", "ru": "сжигать калории", "pos": "phrase", "level": 6, "cefr": "B2", "example": {"es": "Nuotare è un buon modo per bruciare calorie.", "ru": "Плавание — хороший способ сжигать калории."}},
    {"id": "gym.frequenza_cardiaca", "es": "la frequenza cardiaca", "ru": "частота пульса", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "Controlla la frequenza cardiaca durante la corsa.", "ru": "Следи за пульсом во время бега."}},
    {"id": "gym.cardiofrequenzimetro", "es": "il cardiofrequenzimetro", "ru": "пульсометр", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Il mio orologio ha il cardiofrequenzimetro.", "ru": "В моих часах есть пульсометр."}},
    {"id": "gym.postura", "es": "la postura", "ru": "положение тела, осанка", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "Tieni la schiena dritta: la postura è fondamentale.", "ru": "Держи спину прямо: положение тела — главное."}},
    {"id": "gym.tecnica", "es": "la tecnica", "ru": "техника (выполнения)", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "Cura la tecnica prima di aumentare il peso.", "ru": "Сначала отработай технику, потом добавляй вес."}},
