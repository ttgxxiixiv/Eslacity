    {"id": "gym.plank", "es": "il plank", "ru": "планка (упражнение)", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Tieni il plank per un minuto.", "ru": "Продержись в планке минуту."}},
    {"id": "gym.circuito", "es": "il circuito", "ru": "круговая тренировка", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Oggi facciamo un circuito di otto esercizi.", "ru": "Сегодня круговая из восьми упражнений."}},
    {"id": "gym.allenamento_a_intervalli", "es": "l'allenamento a intervalli", "ru": "интервальная тренировка", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "L'allenamento a intervalli è breve ma intenso.", "ru": "Интервальная тренировка короткая, но интенсивная."}},
    {"id": "gym.idratazione", "es": "l'idratazione", "ru": "питьевой режим, гидратация", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "D'estate l'idratazione è fondamentale.", "ru": "Летом особенно важно пить воду."}},
    {"id": "gym.bevanda_isotonica", "es": "la bevanda isotonica", "ru": "изотоник", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "Dopo la partita bevo una bevanda isotonica.", "ru": "После матча я пью изотоник."}},
    {"id": "gym.creatina", "es": "la creatina", "ru": "креатин", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "Alcuni prendono la creatina per aumentare la forza.", "ru": "Некоторые принимают креатин, чтобы стать сильнее."}},
    {"id": "gym.traguardo", "es": "il traguardo", "ru": "цель (спортивная), рубеж", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Il mio traguardo è correre dieci chilometri senza fermarmi.", "ru": "Моя цель — пробежать десять километров без остановки."}},
    {"id": "gym.forza_di_volonta", "es": "la forza di volontà", "ru": "сила воли", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "Alzarsi alle sei richiede forza di volontà.", "ru": "Вставать в шесть — нужна сила воли."}},
    {"id": "gym.sfinito", "es": "sfinito", "ru": "измотанный, выбившийся из сил", "pos": "adj", "level": 6, "cefr": "B2", "example": {"es": "Sono uscito dalla lezione di spinning sfinito.", "ru": "С сайкла я вышел совсем без сил."}},
    {"id": "gym.flessibilita", "es": "la flessibilità", "ru": "гибкость", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "Lo yoga migliora la flessibilità.", "ru": "Йога развивает гибкость."}},
    {"id": "gym.tonificare", "es": "tonificare", "ru": "приводить в тонус", "pos": "verb", "level": 6, "cefr": "B2", "example": {"es": "Questi esercizi servono a tonificare le gambe.", "ru": "Эти упражнения подтягивают ноги."}},
    {"id": "gym.disdire_l_abbonamento", "es": "disdire l'abbonamento", "ru": "расторгнуть абонемент", "pos": "phrase", "level": 6, "cefr": "B2", "example": {"es": "È difficile disdire l'abbonamento in questa palestra.", "ru": "В этом зале трудно расторгнуть абонемент."}},
    {"id": "gym.doping", "es": "il doping", "ru": "допинг", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Lo hanno squalificato per doping.", "ru": "Его дисквалифицировали за допинг."}},
    {"id": "gym.fisioterapista", "es": "il fisioterapista", "ru": "физиотерапевт", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Il fisioterapista mi ha dato esercizi per il ginocchio.", "ru": "Физиотерапевт дал мне упражнения для колена."}},
    {"id": "gym.ipertrofia", "es": "l'ipertrofia", "ru": "гипертрофия (рост мышц)", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "Per l'ipertrofia fa serie da dieci ripetizioni.", "ru": "Для роста мышц он делает подходы по десять повторений."}},
    {"id": "gym.gluteo", "es": "il gluteo", "ru": "ягодичная мышца", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Questo esercizio lavora il gluteo.", "ru": "Это упражнение прорабатывает ягодицы."}},
    {"id": "gym.quadricipite", "es": "il quadricipite", "ru": "квадрицепс", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Gli squat rinforzano il quadricipite.", "ru": "Приседания укрепляют квадрицепс."}},
    {"id": "gym.femorali", "es": "i femorali", "ru": "задняя поверхность бедра", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Allunga bene i femorali dopo la corsa.", "ru": "После бега хорошо растяни заднюю поверхность бедра."}},
    {"id": "gym.affondo", "es": "l'affondo", "ru": "выпад", "pos": "noun", "gender": "m", "level": 7, "cefr": "B2", "example": {"es": "Fai dieci affondi per gamba.", "ru": "Сделай по десять выпадов на каждую ногу."}},
    {"id": "gym.stacco_da_terra", "es": "lo stacco da terra", "ru": "становая тяга", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Nello stacco da terra la schiena resta dritta.", "ru": "В становой тяге спина остаётся прямой."}},
    {"id": "gym.bilanciere", "es": "il bilanciere", "ru": "штанга", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Carica il bilanciere con venti chili per lato.", "ru": "Повесь на штангу по двадцать килограммов с каждой стороны."}},
    {"id": "gym.kettlebell", "es": "il kettlebell", "ru": "гиря", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Con il kettlebell si allena tutto il corpo.", "ru": "С гирей тренируется всё тело."}},
