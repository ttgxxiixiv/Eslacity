    {"id": "gym.spalliera", "es": "la spalliera", "ru": "шведская стенка", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "Si appende alla spalliera per allungare la schiena.", "ru": "Он висит на шведской стенке, чтобы растянуть спину."}},
    {"id": "gym.sacco_da_boxe", "es": "il sacco da boxe", "ru": "боксёрская груша", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Scarica lo stress sul sacco da boxe.", "ru": "Он снимает стресс на боксёрской груше."}},
    {"id": "gym.calistenia", "es": "la calistenia", "ru": "калистеника (упражнения с собственным весом)", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "La calistenia si può fare in qualsiasi parco.", "ru": "Калистеникой можно заниматься в любом парке."}},
    {"id": "gym.digiuno_intermittente", "es": "il digiuno intermittente", "ru": "интервальное голодание", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Fa il digiuno intermittente e non cena mai.", "ru": "Он практикует интервальное голодание и никогда не ужинает."}},
    {"id": "gym.deficit_calorico", "es": "il deficit calorico", "ru": "дефицит калорий", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Per dimagrire serve un deficit calorico.", "ru": "Чтобы похудеть, нужен дефицит калорий."}},
    {"id": "gym.macronutrienti", "es": "i macronutrienti", "ru": "макронутриенты (белки, жиры, углеводы)", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "L'app conta i macronutrienti di ogni pasto.", "ru": "Приложение считает белки, жиры и углеводы каждого приёма пищи."}},
    {"id": "gym.sovrappeso", "es": "il sovrappeso", "ru": "лишний вес", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Il medico gli ha detto che è in sovrappeso.", "ru": "Врач сказал ему, что у него лишний вес."}},
    {"id": "gym.obesita", "es": "l'obesità", "ru": "ожирение", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "L'obesità infantile preoccupa i medici.", "ru": "Детское ожирение беспокоит врачей."}},
    {"id": "gym.agilita", "es": "l'agilità", "ru": "ловкость", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "Gli esercizi di agilità migliorano l'equilibrio.", "ru": "Упражнения на ловкость улучшают равновесие."}},
    {"id": "gym.coordinazione", "es": "la coordinazione", "ru": "координация", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "Ballare migliora la coordinazione.", "ru": "Танцы улучшают координацию."}},
    {"id": "gym.acido_lattico", "es": "l'acido lattico", "ru": "молочная кислота", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "L'acido lattico ti fa bruciare i muscoli.", "ru": "От молочной кислоты мышцы горят."}},
    {"id": "gym.fatica", "es": "la fatica", "ru": "усталость, утомление", "pos": "noun", "gender": "f", "level": 7, "cefr": "B2", "example": {"es": "La fatica muscolare arriva alla fine della serie.", "ru": "Мышечная усталость приходит в конце подхода."}},
    {"id": "gym.soglia", "es": "la soglia", "ru": "порог", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "Si allena appena sotto la soglia anaerobica.", "ru": "Он тренируется чуть ниже анаэробного порога."}},
    {"id": "gym.record_personale", "es": "il record personale", "ru": "личный рекорд", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Oggi ho battuto il mio record personale di panca.", "ru": "Сегодня я побил свой рекорд в жиме лёжа."}},
    {"id": "gym.podio", "es": "il podio", "ru": "пьедестал", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "È salito sul podio per la prima volta.", "ru": "Он впервые поднялся на пьедестал."}},
    {"id": "gym.panca_piana", "es": "la panca piana", "ru": "скамья для жима", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "Aspetto che si liberi la panca piana.", "ru": "Жду, когда освободится скамья для жима."}},
    {"id": "gym.si_prega_di_pulire_gli_attrezzi_dopo_l_uso", "es": "si prega di pulire gli attrezzi dopo l'uso", "ru": "просьба протирать тренажёры после использования", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "formula", "register": "formal", "pair": "gym.pulisci_la_macchina_dai", "example": {"es": "Sul muro: si prega di pulire gli attrezzi dopo l'uso.", "ru": "На стене: просьба протирать тренажёры после использования."}},
    {"id": "gym.pulisci_la_macchina_dai", "es": "pulisci la macchina, dai", "ru": "протри тренажёр, пожалуйста", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "formula", "register": "informal", "pair": "gym.si_prega_di_pulire_gli_attrezzi_dopo_l_uso", "example": {"es": "Ehi, pulisci la macchina, dai, è tutta sudata.", "ru": "Эй, протри тренажёр, он весь потный."}},
    {"id": "gym.desidera_iscriversi", "es": "Desidera iscriversi?", "ru": "желаете оформить абонемент?", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "formula", "register": "formal", "pair": "gym.ti_iscrivi", "example": {"es": "Buongiorno, desidera iscriversi in palestra?", "ru": "Доброе утро, желаете оформить абонемент в зал?"}},
    {"id": "gym.ti_iscrivi", "es": "Ti iscrivi?", "ru": "ты с нами? запишешься?", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "formula", "register": "informal", "pair": "gym.desidera_iscriversi", "example": {"es": "Lunedì iniziamo spinning, ti iscrivi?", "ru": "В понедельник начинаем сайклинг, ты с нами?"}},
    {"id": "gym.svolgere_attivita_fisica", "es": "svolgere attività fisica", "ru": "заниматься физической активностью", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "collocation", "register": "formal", "pair": "gym.sgranchirsi_le_gambe", "example": {"es": "Si consiglia di svolgere attività fisica ogni giorno.", "ru": "Рекомендуется ежедневно заниматься физической активностью."}},
    {"id": "gym.sgranchirsi_le_gambe", "es": "sgranchirsi le gambe", "ru": "размяться, подвигаться", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "informal", "pair": "gym.svolgere_attivita_fisica", "literal": "размять себе ноги", "example": {"es": "Dai, sgranchisciti le gambe, sei seduto da ore.", "ru": "Давай, разомнись, ты сидишь уже несколько часов."}},
    {"id": "gym.sudare_sette_camicie", "es": "sudare sette camicie", "ru": "попотеть, выложиться", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "informal", "literal": "пропотеть семь рубашек", "example": {"es": "A lezione di spinning abbiamo sudato sette camicie.", "ru": "На сайклинге мы изрядно попотели."}},
    {"id": "gym.essere_un_toro", "es": "essere un toro", "ru": "быть здоровяком", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "informal", "literal": "быть быком", "example": {"es": "Da quando va in palestra è un toro.", "ru": "С тех пор как он ходит в зал, он настоящий здоровяк."}},
    {"id": "gym.gettare_la_spugna", "es": "gettare la spugna", "ru": "сдаться", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "neutral", "literal": "бросить губку", "example": {"es": "Stava per gettare la spugna, ma ha continuato.", "ru": "Он чуть не сдался, но продолжил."}},
    {"id": "gym.non_azzeccarne_una", "es": "non azzeccarne una", "ru": "всё делать невпопад", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "informal", "literal": "не угадать ни одного", "example": {"es": "Oggi a ballo mi sembra di non azzeccarne una.", "ru": "Сегодня на танцах у меня, кажется, всё невпопад."}},
    {"id": "gym.darsi_una_mossa", "es": "darsi una mossa", "ru": "поднажать, пошевеливаться", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "informal", "literal": "дать себе движение", "example": {"es": "Se vuoi fare la maratona, datti una mossa.", "ru": "Хочешь пробежать марафон — поднажми."}},
    {"id": "gym.dare_il_massimo", "es": "dare il massimo", "ru": "выложиться полностью", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "collocation", "register": "neutral", "example": {"es": "Nell'ultimo chilometro ha dato il massimo.", "ru": "На последнем километре он выложился полностью."}},
    {"id": "gym.essere_in_gran_forma", "es": "essere in gran forma", "ru": "быть в отличной форме", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "collocation", "register": "neutral", "example": {"es": "A sessant'anni è ancora in gran forma.", "ru": "В шестьдесят он по-прежнему в отличной форме."}},
    {"id": "gym.fare_fiato", "es": "fare fiato", "ru": "набрать выносливость", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "collocation", "register": "informal", "example": {"es": "Corro tre volte a settimana per fare fiato.", "ru": "Я бегаю три раза в неделю, чтобы набрать выносливость."}},
    {"id": "gym.fisico", "es": "il fisico", "ru": "телосложение, фигура", "pos": "noun", "gender": "m", "level": 7, "cefr": "B1", "kind": "false-friend", "register": "neutral", "note": "Не физик. Il fisico — телосложение, фигура: avere un bel fisico. Физик (учёный) — il fisico тоже, но в зале это всегда тело.", "example": {"es": "Con la palestra si è fatto un bel fisico.", "ru": "В зале он накачал отличную фигуру."}}
  ]
