    {"id": "beach.tenere_il_piede_in_due_scarpe", "es": "tenere il piede in due scarpe", "ru": "усидеть на двух стульях", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "informal", "literal": "держать ногу в двух ботинках", "example": {"es": "Vuole tenere il piede in due scarpe, ma non si può.", "ru": "Он хочет усидеть на двух стульях, а так не бывает."}},
