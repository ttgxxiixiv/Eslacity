    {"id": "post.sigillo", "es": "il sigillo", "ru": "пломба", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Il sigillo era rotto quando l'ho ricevuto.", "ru": "Когда я получил посылку, пломба была сорвана."}},
