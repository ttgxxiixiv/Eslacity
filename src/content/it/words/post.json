    {"id": "post.baci", "es": "baci", "ru": "целую (в конце письма)", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "formula", "register": "informal", "pair": "post.distinti_saluti", "example": {"es": "Mi manchi tanto. Baci, Lucia.", "ru": "Очень скучаю. Целую, Лючия."}},
    {"id": "post.a_stretto_giro_di_posta", "es": "a stretto giro di posta", "ru": "немедленно, с обратной почтой", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "collocation", "register": "formal", "example": {"es": "La preghiamo di risponderci a stretto giro di posta.", "ru": "Просим ответить нам немедленно."}},
