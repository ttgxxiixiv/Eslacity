    {"id": "post.punto_di_ritiro", "es": "il punto di ritiro", "ru": "пункт выдачи", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Puoi ritirare l'ordine in un punto di ritiro.", "ru": "Заказ можно забрать в пункте выдачи."}},
    {"id": "post.locker", "es": "il locker", "ru": "постамат, ячейка для посылок", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Ritira il pacco nel locker della stazione.", "ru": "Забери посылку в постамате на вокзале."}},
    {"id": "post.inoltro", "es": "l'inoltro", "ru": "переадресация", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Ho chiesto l'inoltro della posta alla nuova casa.", "ru": "Я заказал переадресацию почты на новый адрес."}},
