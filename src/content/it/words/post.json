    {"id": "post.far_pervenire", "es": "far pervenire", "ru": "передать, направить", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "collocation", "register": "formal", "example": {"es": "Le faremo pervenire i documenti entro venerdì.", "ru": "Мы направим вам документы до пятницы."}},
    {"id": "post.lasciare_in_visualizzato", "es": "lasciare in visualizzato", "ru": "прочитать и не ответить", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "informal", "literal": "оставить в «просмотрено»", "example": {"es": "Le ho scritto ieri e mi ha lasciato in visualizzato.", "ru": "Я написал ей вчера, а она прочитала и не ответила."}},
    {"id": "post.meglio_tardi_che_mai", "es": "meglio tardi che mai", "ru": "лучше поздно, чем никогда", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "neutral", "literal": "лучше поздно, чем никогда", "example": {"es": "La tua cartolina è arrivata a marzo, ma meglio tardi che mai.", "ru": "Твоя открытка пришла в марте, но лучше поздно, чем никогда."}},
    {"id": "post.non_avere_notizie_di", "es": "non avere notizie di", "ru": "не иметь вестей от", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "collocation", "register": "neutral", "example": {"es": "Da mesi non ho notizie di mio cugino.", "ru": "Уже несколько месяцев нет вестей от двоюродного брата."}},
