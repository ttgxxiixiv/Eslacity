    {"id": "post.notifica", "es": "la notifica", "ru": "уведомление", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "Ho ricevuto una notifica sul cellulare.", "ru": "Мне пришло уведомление на телефон."}},
