    {"id": "post.sovraccarico", "es": "il sovraccarico", "ru": "перегрузка, завал", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "A Natale c'è un sovraccarico di spedizioni.", "ru": "На Рождество завал с отправлениями."}},
