    {"id": "post.poscritto", "es": "il poscritto", "ru": "постскриптум", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Nel poscritto mi chiedeva scusa.", "ru": "В постскриптуме он просил у меня прощения."}},
