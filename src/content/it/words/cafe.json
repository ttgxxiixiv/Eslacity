    {"id": "cafe.capienza", "es": "la capienza", "ru": "вместимость (зала)", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "La capienza del locale è di quaranta persone.", "ru": "Заведение вмещает сорок человек."}},
    {"id": "cafe.gremito", "es": "gremito", "ru": "битком набитый", "pos": "adj", "level": 6, "cefr": "B2", "example": {"es": "Alle nove il bar è gremito.", "ru": "В девять бар набит битком."}},
    {"id": "cafe.chiasso", "es": "il chiasso", "ru": "шум, гам", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Mi piace il chiasso del bar la mattina.", "ru": "Мне нравится утренний гам в баре."}},
    {"id": "cafe.pazienza", "es": "la pazienza", "ru": "терпение", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "Grazie per la pazienza, il caffè arriva subito.", "ru": "Спасибо за терпение, кофе сейчас принесут."}},
    {"id": "cafe.servizio", "es": "il servizio", "ru": "обслуживание", "pos": "noun", "gender": "m", "level": 6, "cefr": "A2", "example": {"es": "Il servizio qui è lento, ma il personale è gentile.", "ru": "Обслуживают здесь медленно, но персонал вежливый."}},
    {"id": "cafe.malinteso", "es": "il malinteso", "ru": "недоразумение", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "È stato un malinteso: avevo chiesto un macchiato.", "ru": "Вышло недоразумение: я заказывал макиато."}},
    {"id": "cafe.svista", "es": "la svista", "ru": "оплошность, недосмотр", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "Mi scusi, è stata una mia svista.", "ru": "Простите, это мой недосмотр."}},
    {"id": "cafe.disturbo", "es": "il disturbo", "ru": "беспокойство, неудобство", "pos": "noun", "gender": "m", "level": 6, "cefr": "B1", "example": {"es": "Scusi il disturbo, stiamo pulendo il bancone.", "ru": "Простите за беспокойство, мы протираем стойку."}},
    {"id": "cafe.clientela", "es": "la clientela", "ru": "клиентура, посетители", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "La clientela del bar è soprattutto gente anziana.", "ru": "Посетители бара в основном пожилые люди."}},
    {"id": "cafe.fedele", "es": "fedele", "ru": "верный, постоянный", "pos": "adj", "level": 6, "cefr": "B2", "example": {"es": "È un cliente fedele da vent'anni.", "ru": "Он постоянный клиент уже двадцать лет."}},
    {"id": "cafe.gestore", "es": "il gestore", "ru": "хозяин заведения, управляющий", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Il gestore del bar ci ha offerto un altro giro.", "ru": "Хозяин бара угостил нас ещё одним кругом."}},
    {"id": "cafe.giro", "es": "il giro", "ru": "круг (угощение для всей компании)", "pos": "noun", "gender": "m", "level": 6, "cefr": "A2", "example": {"es": "Questo giro lo offro io.", "ru": "Этот круг за мной."}},
    {"id": "cafe.sfogarsi", "es": "sfogarsi", "ru": "выговориться", "pos": "verb", "level": 6, "cefr": "B2", "example": {"es": "Avevo bisogno di sfogarmi con qualcuno.", "ru": "Мне нужно было кому-нибудь выговориться."}},
    {"id": "cafe.diceria", "es": "la diceria", "ru": "слух, сплетня", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "Al bancone gira sempre qualche diceria.", "ru": "У стойки всегда ходит какой-нибудь слух."}},
    {"id": "cafe.spettegolare", "es": "spettegolare", "ru": "сплетничать", "pos": "verb", "level": 6, "cefr": "B2", "example": {"es": "Smettetela di spettegolare sui vicini.", "ru": "Хватит сплетничать о соседях."}},
    {"id": "cafe.aneddoto", "es": "l'aneddoto", "ru": "забавный случай из жизни", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Mio nonno racconta sempre lo stesso aneddoto.", "ru": "Дедушка всегда рассказывает одну и ту же историю."}},
    {"id": "cafe.confidarsi", "es": "confidarsi", "ru": "довериться, открыться", "pos": "verb", "level": 6, "cefr": "B2", "example": {"es": "Alla fine si è confidata con me.", "ru": "В конце концов она мне открылась."}},
    {"id": "cafe.lavorare_da_remoto", "es": "lavorare da remoto", "ru": "работать удалённо", "pos": "phrase", "level": 6, "cefr": "B2", "example": {"es": "Molti vengono qui a lavorare da remoto.", "ru": "Многие приходят сюда поработать удалённо."}},
    {"id": "cafe.nostalgia", "es": "la nostalgia", "ru": "ностальгия", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "Questo bar mi fa venire nostalgia della mia giovinezza.", "ru": "Этот бар вызывает у меня ностальгию по молодости."}},
    {"id": "cafe.incontro", "es": "l'incontro", "ru": "встреча", "pos": "noun", "gender": "m", "level": 6, "cefr": "A2", "example": {"es": "È stato un incontro inaspettato con una vecchia amica.", "ru": "Это была неожиданная встреча со старой подругой."}},
    {"id": "cafe.inaspettato", "es": "inaspettato", "ru": "неожиданный", "pos": "adj", "level": 6, "cefr": "B2", "example": {"es": "Ho ricevuto una visita inaspettata al bar.", "ru": "В баре ко мне пришёл неожиданный гость."}},
    {"id": "cafe.caffeina", "es": "la caffeina", "ru": "кофеин", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "Il pomeriggio evito la caffeina.", "ru": "После обеда я избегаю кофеина."}},
    {"id": "cafe.latte_d_avena", "es": "il latte d'avena", "ru": "овсяное молоко", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Avete latte d'avena per il cappuccino?", "ru": "У вас есть овсяное молоко для капучино?"}},
    {"id": "cafe.tostatura", "es": "la tostatura", "ru": "обжарка (кофе)", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "Questo caffè ha una tostatura leggera.", "ru": "У этого кофе лёгкая обжарка."}},
    {"id": "cafe.palato", "es": "il palato", "ru": "вкус, нёбо", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Ha un palato finissimo per il caffè.", "ru": "У него очень тонкий вкус к кофе."}},
    {"id": "cafe.retrogusto", "es": "il retrogusto", "ru": "послевкусие", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Lascia un retrogusto amarognolo molto piacevole.", "ru": "Оставляет очень приятное горьковатое послевкусие."}},
    {"id": "cafe.acidita", "es": "l'acidità", "ru": "кислотность", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "I chicchi etiopi hanno più acidità.", "ru": "У эфиопских зёрен больше кислотности."}},
    {"id": "cafe.interlocutore", "es": "l'interlocutore", "ru": "собеседник", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Ascolta sempre il suo interlocutore fino in fondo.", "ru": "Он всегда выслушивает собеседника до конца."}},
    {"id": "cafe.confidenza", "es": "la confidenza", "ru": "доверительность, близость", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "Tra noi c'è molta confidenza.", "ru": "Между нами большая близость."}},
    {"id": "cafe.sfogo", "es": "lo sfogo", "ru": "отдушина, выплеск чувств", "pos": "noun", "gender": "m", "level": 7, "cefr": "B2", "example": {"es": "Queste chiacchierate sono il mio sfogo della settimana.", "ru": "Эти разговоры — моя отдушина за неделю."}},
    {"id": "cafe.complicita", "es": "la complicità", "ru": "взаимопонимание, заговорщицкая близость", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "Tra loro c'è una complicità di anni.", "ru": "Между ними многолетнее взаимопонимание."}},
    {"id": "cafe.schiettezza", "es": "la schiettezza", "ru": "откровенность, прямота", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "Te lo dico con tutta la schiettezza possibile.", "ru": "Говорю тебе совершенно откровенно."}},
    {"id": "cafe.frecciatina", "es": "la frecciatina", "ru": "намёк, шпилька", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "Quella era una frecciatina per me, vero?", "ru": "Это была шпилька в мой адрес, да?"}},
    {"id": "cafe.rimprovero", "es": "il rimprovero", "ru": "упрёк", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Non voglio rimproveri, solo una spiegazione.", "ru": "Мне не нужны упрёки, только объяснение."}},
    {"id": "cafe.riconciliazione", "es": "la riconciliazione", "ru": "примирение", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "La riconciliazione è arrivata con un caffè e un abbraccio.", "ru": "Примирение случилось за чашкой кофе и с объятием."}},
    {"id": "cafe.dissapore", "es": "il dissapore", "ru": "размолвка, мелкая ссора", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "I dissapori tra vicini si risolvono con un caffè.", "ru": "Размолвки между соседями улаживаются за чашкой кофе."}},
    {"id": "cafe.svago", "es": "lo svago", "ru": "развлечение, отдых", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Il bar è il posto di svago del quartiere.", "ru": "Бар — место отдыха для всего квартала."}},
    {"id": "cafe.penombra", "es": "la penombra", "ru": "полумрак", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "La sera il locale resta in penombra.", "ru": "Вечером в заведении полумрак."}},
    {"id": "cafe.vetrata", "es": "la vetrata", "ru": "большое окно, стеклянная стена", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "Mi siedo vicino alla vetrata per guardare la piazza.", "ru": "Я сажусь у большого окна, чтобы видеть площадь."}},
    {"id": "cafe.intimo", "es": "intimo", "ru": "камерный, уютный", "pos": "adj", "level": 7, "cefr": "B2", "example": {"es": "Il bar ha un ambiente intimo.", "ru": "В баре камерная обстановка."}},
    {"id": "cafe.struggente", "es": "struggente", "ru": "щемящий", "pos": "adj", "level": 7, "cefr": "C1", "example": {"es": "Quella canzone ha una malinconia struggente.", "ru": "В этой песне щемящая грусть."}},
    {"id": "cafe.effimero", "es": "effimero", "ru": "мимолётный", "pos": "adj", "level": 7, "cefr": "C1", "example": {"es": "È stato un incontro effimero ma intenso.", "ru": "Встреча была мимолётной, но яркой."}},
    {"id": "cafe.habitue", "es": "l'habitué", "ru": "завсегдатай", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Gli habitué hanno il loro tavolo di sempre.", "ru": "У завсегдатаев свой постоянный столик."}},
    {"id": "cafe.evocare", "es": "evocare", "ru": "вызывать в памяти", "pos": "verb", "level": 7, "cefr": "C1", "example": {"es": "Questo profumo mi evoca la casa della nonna.", "ru": "Этот запах напоминает мне бабушкин дом."}},
    {"id": "cafe.divagare", "es": "divagare", "ru": "отвлекаться от темы", "pos": "verb", "level": 7, "cefr": "C1", "example": {"es": "Scusa, sto divagando di nuovo.", "ru": "Прости, я опять отвлёкся от темы."}},
    {"id": "cafe.assaporare", "es": "assaporare", "ru": "смаковать", "pos": "verb", "level": 7, "cefr": "C1", "example": {"es": "Mi piace assaporare il primo caffè della giornata.", "ru": "Люблю смаковать первый кофе за день."}},
    {"id": "cafe.sorseggiare", "es": "sorseggiare", "ru": "потягивать (напиток)", "pos": "verb", "level": 7, "cefr": "C1", "example": {"es": "Sorseggiava il suo cappuccino leggendo il giornale.", "ru": "Он потягивал капучино, читая газету."}},
    {"id": "cafe.malinconia", "es": "la malinconia", "ru": "меланхолия, грусть", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "La pioggia mi mette malinconia.", "ru": "Дождь нагоняет на меня грусть."}},
    {"id": "cafe.desidera_altro", "es": "Desidera altro?", "ru": "желаете что-нибудь ещё?", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "formula", "register": "formal", "pair": "cafe.te_ne_faccio_un_altro", "example": {"es": "Desidera altro, signora?", "ru": "Желаете что-нибудь ещё, синьора?"}},
    {"id": "cafe.te_ne_faccio_un_altro", "es": "Te ne faccio un altro?", "ru": "тебе повторить?", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "formula", "register": "informal", "pair": "cafe.desidera_altro", "example": {"es": "Hai finito lo spritz, te ne faccio un altro?", "ru": "Ты допил шприц, повторить?"}},
    {"id": "cafe.permette", "es": "Permette?", "ru": "разрешите? (присесть, взять)", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "formula", "register": "formal", "pair": "cafe.c_e_posto", "example": {"es": "Permette? I tavoli sono tutti occupati.", "ru": "Разрешите? Все столики заняты."}},
    {"id": "cafe.c_e_posto", "es": "C'è posto?", "ru": "найдётся местечко?", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "formula", "register": "informal", "pair": "cafe.permette", "example": {"es": "Siamo in cinque, c'è posto per noi?", "ru": "Нас пятеро, найдётся для нас местечко?"}},
    {"id": "cafe.mi_permetta_di_offrirle_qualcosa", "es": "mi permetta di offrirLe qualcosa", "ru": "позвольте вас угостить", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "formula", "register": "formal", "pair": "cafe.questo_giro_lo_offro_io", "example": {"es": "Mi permetta di offrirLe qualcosa, la prego.", "ru": "Позвольте вас чем-нибудь угостить."}},
    {"id": "cafe.questo_giro_lo_offro_io", "es": "questo giro lo offro io", "ru": "этот круг за мной", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "formula", "register": "informal", "pair": "cafe.mi_permetta_di_offrirle_qualcosa", "example": {"es": "Metti via il portafoglio, questo giro lo offro io.", "ru": "Убери кошелёк, этот круг за мной."}},
    {"id": "cafe.ammazzare_il_tempo", "es": "ammazzare il tempo", "ru": "коротать время", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "informal", "literal": "убить время", "example": {"es": "Leggo il giornale per ammazzare il tempo.", "ru": "Я читаю газету, чтобы скоротать время."}},
    {"id": "cafe.fare_quattro_chiacchiere", "es": "fare quattro chiacchiere", "ru": "поболтать немного", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "neutral", "literal": "сделать четыре болтовни", "example": {"es": "Passa da me, facciamo quattro chiacchiere.", "ru": "Заходи, поболтаем немного."}},
    {"id": "cafe.menare_il_can_per_l_aia", "es": "menare il can per l'aia", "ru": "ходить вокруг да около", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "informal", "literal": "водить собаку по гумну", "example": {"es": "Non menare il can per l'aia e dimmi cosa è successo.", "ru": "Не ходи вокруг да около и скажи, что случилось."}},
    {"id": "cafe.cavare_le_parole_di_bocca", "es": "cavare le parole di bocca", "ru": "вытягивать слова клещами", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "informal", "literal": "вытаскивать слова изо рта", "example": {"es": "Con lui bisogna cavare le parole di bocca.", "ru": "Из него слова надо вытягивать клещами."}},
    {"id": "cafe.restare_di_sasso", "es": "restare di sasso", "ru": "остолбенеть", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "informal", "literal": "остаться камнем", "example": {"es": "Quando l'ho visto entrare, sono restato di sasso.", "ru": "Когда я увидел, как он входит, я остолбенел."}},
    {"id": "cafe.non_chiudere_occhio", "es": "non chiudere occhio", "ru": "не сомкнуть глаз", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "informal", "literal": "не закрыть глаза", "example": {"es": "Ho preso tre caffè e non ho chiuso occhio.", "ru": "Я выпил три кофе и не сомкнул глаз."}},
    {"id": "cafe.avere_la_testa_fra_le_nuvole", "es": "avere la testa fra le nuvole", "ru": "витать в облаках", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "neutral", "literal": "иметь голову среди облаков", "example": {"es": "Scusa, avevo la testa fra le nuvole. Cosa dicevi?", "ru": "Прости, я витал в облаках. Что ты говорил?"}},
    {"id": "cafe.parlare_a_vanvera", "es": "parlare a vanvera", "ru": "болтать без толку", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "informal", "literal": "говорить наобум", "example": {"es": "Non ascoltarlo, parla sempre a vanvera.", "ru": "Не слушай его, он всегда болтает без толку."}},
    {"id": "cafe.bar", "es": "il bar", "ru": "кофейня у стойки", "pos": "noun", "gender": "m", "level": 7, "cefr": "A2", "kind": "false-friend", "register": "neutral", "note": "Не питейное заведение. Il bar — кафе, где с утра пьют кофе у стойки. Вечерний бар с коктейлями — il pub или il locale.", "example": {"es": "Ogni mattina faccio colazione al bar sotto casa.", "ru": "Каждое утро я завтракаю в кафе под домом."}}
  ]
