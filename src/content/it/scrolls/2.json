    {"id": "scroll2.vita", "es": "la vita", "ru": "жизнь", "pos": "noun", "gender": "f", "level": 1, "cefr": "A2", "example": {"es": "Il libro racconta la vita del cronista.", "ru": "Книга рассказывает о жизни Летописца."}},
