            "dormo",
            "capisco"
          ]
        },
        {
          "cells": [
            "tu",
            "dormi",
            "capisci"
          ]
        },
        {
          "cells": [
            "lui / lei",
            "dorme",
            "capisce"
          ]
        },
        {
          "cells": [
            "noi",
            "dormiamo",
            "capiamo"
          ]
        },
        {
          "cells": [
            "voi",
            "dormite",
            "capite"
          ]
        },
        {
          "cells": [
            "loro",
            "dormono",
            "capiscono"
          ]
        }
      ]
    },
    {
      "kind": "tip",
      "md": "Без -isc-: dormire, partire, sentire, aprire, offrire. С -isc-: capire, finire, preferire, pulire, spedire. В словаре это не видно, глаголы нужно запоминать."
    }
  ],
