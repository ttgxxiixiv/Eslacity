{
  "location": "school",
  "scenes": [
    {
      "id": "sc:school.1",
      "chapter": 1,
      "npc": "anna",
      "lines": [
        {"who": "npc", "es": "Cominciamo la lezione?", "ru": "Начнём урок?"},
        {"who": "hero", "es": "Sì. Oggi ho una domanda.", "ru": "Да. Сегодня у меня вопрос."},
        {"who": "npc", "es": "Benissimo. Le domande sono sempre buone.", "ru": "Отлично. Вопросы — это всегда хорошо."},
        {"who": "hero", "es": "Lei sa qualcosa della mappa?", "ru": "Вы что-нибудь знаете о карте?"},
        {"who": "npc", "es": "Ho un pezzo. Guarda: qui ci sono delle parole.", "ru": "У меня есть обрывок. Смотри: здесь какие-то слова."},
        {"who": "hero", "es": "Non capisco questa parola.", "ru": "Я не понимаю это слово."},
        {"who": "npc", "es": "È italiano molto vecchio, come Dante. Dice: «Solo chi parla, passa».", "ru": "Это очень старый итальянский, как у Данте. Здесь написано: «Пройдёт только тот, кто говорит»."},
        {"who": "hero", "es": "Passa? Dove?", "ru": "Пройдёт? Куда?"},
        {"who": "npc", "es": "Al Caveau. Alla porta, qualcuno fa domande. Passa solo chi sa rispondere.", "ru": "В Хранилище. У двери кто-то задаёт вопросы. Пройдёт только тот, кто сумеет ответить."},
        {"who": "hero", "es": "Allora devo studiare molto.", "ru": "Значит, мне нужно много учиться."},
        {"who": "npc", "es": "Per questo sei qui. Cominciamo!", "ru": "Поэтому ты здесь. Начинаем!"}
      ],
      "questions": [
        {"q": "С чем герой пришёл на урок?", "options": ["С вопросом", "С экзаменом", "С новой тетрадью"], "answer": 0},
        {"q": "Что написано на обрывке?", "options": ["«Пройдёт только тот, кто говорит»", "«Дорога идёт к морю»", "«Карта лежит в банке»"], "answer": 0},
        {"q": "Кто ждёт у двери Хранилища?", "options": ["Почтальон", "Кто-то, кто задаёт вопросы", "Никого нет"], "answer": 1},
        {"q": "Что решает герой?", "options": ["Бросить поиски", "Купить новую карту", "Много учиться"], "answer": 2}
      ],
      "gloss": {"pezzo": "обрывок", "caveau": "Хранилище", "dante": "Данте, великий итальянский поэт"}
    }
