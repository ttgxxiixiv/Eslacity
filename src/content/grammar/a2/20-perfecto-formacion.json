            "ha",
            "ha vivido"
          ]
        },
        {
          "cells": [
            "nosotros",
            "hemos",
            "hemos hablado"
          ]
        },
        {
          "cells": [
            "vosotros",
            "habéis",
            "habéis comido"
          ],
          "region": "es"
        },
        {
          "cells": [
            "ellos / ellas / ustedes",
            "han",
            "han vivido"
          ]
        }
      ]
    },
    {
      "kind": "tip",
      "md": "Причастие: -ar → **-ado**, -er/-ir → **-ido**. Оно не меняется: ella ha comido, ellos han comido. Между haber и причастием ничего не ставят: no lo **he visto**."
    }
  ],
