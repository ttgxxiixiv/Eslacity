    {"id": "scroll3.conocido", "es": "el conocido", "ru": "знакомый", "pos": "noun", "gender": "m", "level": 1, "cefr": "B1", "example": {"es": "No es un amigo, es solo un conocido.", "ru": "Он не друг, просто знакомый."}},
    {"id": "scroll3.acompanar", "es": "acompañar", "ru": "сопровождать", "pos": "verb", "level": 1, "cefr": "B1", "example": {"es": "El Cronista nos acompaña hasta el bosque.", "ru": "Летописец провожает нас до леса."}},
    {"id": "scroll3.reunirse", "es": "reunirse", "ru": "собираться вместе", "pos": "verb", "level": 1, "cefr": "B1", "example": {"es": "Los guardianes van a reunirse esta noche.", "ru": "Этой ночью стражи соберутся вместе."}},
    {"id": "scroll3.apoyo", "es": "el apoyo", "ru": "поддержка", "pos": "noun", "gender": "m", "level": 1, "cefr": "B1", "example": {"es": "Gracias por tu apoyo en el desierto.", "ru": "Спасибо за поддержку в пустыне."}},
    {"id": "scroll3.apoyar", "es": "apoyar", "ru": "поддерживать", "pos": "verb", "level": 1, "cefr": "B1", "example": {"es": "Toda la ciudad apoya al héroe.", "ru": "Весь город поддерживает героя."}},
    {"id": "scroll3.molestar", "es": "molestar", "ru": "мешать, беспокоить", "pos": "verb", "level": 1, "cefr": "B1", "example": {"es": "No quiero molestar al guardián.", "ru": "Не хочу беспокоить стража."}},
    {"id": "scroll3.enganar", "es": "engañar", "ru": "обманывать", "pos": "verb", "level": 1, "cefr": "B1", "example": {"es": "El mercader engaña a los viajeros.", "ru": "Купец обманывает путников."}},
    {"id": "scroll3.traicionar", "es": "traicionar", "ru": "предавать", "pos": "verb", "level": 1, "cefr": "B1", "example": {"es": "Nunca voy a traicionar a mis amigos.", "ru": "Я никогда не предам друзей."}},
    {"id": "scroll3.ofender", "es": "ofender", "ru": "обижать, оскорблять", "pos": "verb", "level": 1, "cefr": "B1", "example": {"es": "No quería ofender a nadie.", "ru": "Я не хотел никого обидеть."}},
    {"id": "scroll3.verguenza", "es": "la vergüenza", "ru": "стыд", "pos": "noun", "gender": "f", "level": 1, "cefr": "B1", "example": {"es": "Siento vergüenza por mi error.", "ru": "Мне стыдно за свою ошибку."}},
    {"id": "scroll3.orgullo", "es": "el orgullo", "ru": "гордость", "pos": "noun", "gender": "m", "level": 1, "cefr": "B1", "example": {"es": "El pueblo mira al héroe con orgullo.", "ru": "Деревня смотрит на героя с гордостью."}},
    {"id": "scroll3.querido", "es": "querido", "ru": "дорогой, любимый (о человеке)", "pos": "adj", "level": 1, "cefr": "B1", "example": {"es": "Mi querido abuelo me dejó el mapa.", "ru": "Мой дорогой дедушка оставил мне карту."}},
    {"id": "scroll3.gesto", "es": "el gesto", "ru": "жест", "pos": "noun", "gender": "m", "level": 1, "cefr": "B1", "example": {"es": "Un gesto amable abre muchas puertas.", "ru": "Добрый жест открывает многие двери."}},
    {"id": "scroll3.realidad", "es": "la realidad", "ru": "реальность, действительность", "pos": "noun", "gender": "f", "level": 1, "cefr": "B1", "example": {"es": "En el desierto el sueño y la realidad se mezclan.", "ru": "В пустыне сон и явь смешиваются."}},
