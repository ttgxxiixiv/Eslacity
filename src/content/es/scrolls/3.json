    {"id": "scroll3.desarrollar", "es": "desarrollar", "ru": "развивать", "pos": "verb", "level": 1, "cefr": "B1", "example": {"es": "El viaje desarrolla la paciencia.", "ru": "Путешествие развивает терпение."}},
    {"id": "scroll3.fallar", "es": "fallar", "ru": "не удаваться, подводить", "pos": "verb", "level": 1, "cefr": "B1", "example": {"es": "Esta vez el plan no puede fallar.", "ru": "На этот раз план не может провалиться."}},
    {"id": "scroll3.profesional", "es": "profesional", "ru": "профессиональный", "pos": "adj", "level": 1, "cefr": "B1", "example": {"es": "El guía es muy profesional.", "ru": "Проводник очень профессиональный."}},
    {"id": "scroll3.util", "es": "útil", "ru": "полезный", "pos": "adj", "level": 1, "cefr": "B1", "example": {"es": "Este consejo es muy útil.", "ru": "Этот совет очень полезный."}}
