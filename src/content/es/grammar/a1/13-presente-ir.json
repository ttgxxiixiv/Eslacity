            "yo",
            "vivo",
            "-o"
          ]
        },
        {
          "cells": [
            "tú",
            "vives",
            "-es"
          ]
        },
        {
          "cells": [
            "él / ella / usted",
            "vive",
            "-e"
          ]
        },
        {
          "cells": [
            "nosotros",
            "vivimos",
            "-imos"
          ]
        },
        {
          "cells": [
            "vosotros",
            "vivís",
            "-ís"
          ],
          "region": "es"
        },
        {
          "cells": [
            "ellos / ellas / ustedes",
            "viven",
            "-en"
          ]
        }
      ]
    },
    {
      "kind": "tip",
      "md": "Так же: escribir (писать), abrir (открывать), recibir (получать), subir (подниматься)."
    }
  ],
