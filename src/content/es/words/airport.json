    {"id": "airport.confiscar", "es": "confiscar", "ru": "изымать", "pos": "verb", "level": 6, "cefr": "B2", "example": {"es": "Me confiscaron la botella de agua en el control.", "ru": "У меня изъяли бутылку воды на досмотре."}},
