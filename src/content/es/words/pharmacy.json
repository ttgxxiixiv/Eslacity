    {"id": "pharmacy.insulina", "es": "la insulina", "ru": "инсулин", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "La insulina se guarda en la nevera.", "ru": "Инсулин хранят в холодильнике."}},
    {"id": "pharmacy.inhalador", "es": "el inhalador", "ru": "ингалятор", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Siempre lleva el inhalador en el bolso.", "ru": "Она всегда носит ингалятор в сумке."}},
    {"id": "pharmacy.asma", "es": "el asma", "ru": "астма", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "Con el polen, mi asma empeora.", "ru": "Из-за пыльцы моя астма обостряется."}},
    {"id": "pharmacy.erupcion", "es": "la erupción", "ru": "сыпь", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "Me ha salido una erupción en el brazo.", "ru": "У меня на руке появилась сыпь."}},
    {"id": "pharmacy.picor", "es": "el picor", "ru": "зуд", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Esta crema calma el picor.", "ru": "Этот крем снимает зуд."}},
    {"id": "pharmacy.repelente_de_mosquitos", "es": "el repelente de mosquitos", "ru": "средство от комаров", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Antes del viaje compré repelente de mosquitos.", "ru": "Перед поездкой я купил средство от комаров."}},
    {"id": "pharmacy.hierbas_medicinales", "es": "las hierbas medicinales", "ru": "лекарственные травы", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "Mi abuela confía en las hierbas medicinales.", "ru": "Бабушка доверяет лекарственным травам."}},
    {"id": "pharmacy.complemento_alimenticio", "es": "el complemento alimenticio", "ru": "биодобавка", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Este complemento alimenticio no sustituye una dieta sana.", "ru": "Эта биодобавка не заменяет здоровое питание."}},
    {"id": "pharmacy.probiotico", "es": "el probiótico", "ru": "пробиотик", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Con el antibiótico, tome también un probiótico.", "ru": "Вместе с антибиотиком принимайте пробиотик."}},
    {"id": "pharmacy.resaca", "es": "la resaca", "ru": "похмелье", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "Después de la boda tenía una resaca terrible.", "ru": "После свадьбы у меня было ужасное похмелье."}},
    {"id": "pharmacy.acidez", "es": "la acidez", "ru": "изжога", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "La comida picante me da acidez.", "ru": "От острого у меня изжога."}},
    {"id": "pharmacy.laxante", "es": "el laxante", "ru": "слабительное", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "No abuse de los laxantes.", "ru": "Не злоупотребляйте слабительным."}},
    {"id": "pharmacy.diarrea", "es": "la diarrea", "ru": "диарея", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "Para la diarrea, beba mucha agua.", "ru": "При диарее пейте много воды."}},
    {"id": "pharmacy.estrenimiento", "es": "el estreñimiento", "ru": "запор", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "La fibra ayuda contra el estreñimiento.", "ru": "Клетчатка помогает при запоре."}},
    {"id": "pharmacy.desinfectante", "es": "el desinfectante", "ru": "антисептик", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Ponga desinfectante en la herida.", "ru": "Обработайте ранку антисептиком."}},
    {"id": "pharmacy.migrana", "es": "la migraña", "ru": "мигрень", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "Cuando tengo migraña, no soporto la luz.", "ru": "Когда у меня мигрень, я не выношу свет."}},
    {"id": "pharmacy.preservativo", "es": "el preservativo", "ru": "презерватив", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Los preservativos están junto a la caja.", "ru": "Презервативы лежат у кассы."}},
    {"id": "pharmacy.intolerancia_a_la_lactosa", "es": "la intolerancia a la lactosa", "ru": "непереносимость лактозы", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "Si tienes intolerancia a la lactosa, estas pastillas te ayudan con los lácteos.", "ru": "Если у тебя непереносимость лактозы, эти таблетки помогают с молочным."}},
    {"id": "pharmacy.colirio", "es": "el colirio", "ru": "глазные капли", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "El colirio alivia los ojos secos.", "ru": "Глазные капли помогают при сухости глаз."}},
    {"id": "pharmacy.excipiente", "es": "el excipiente", "ru": "вспомогательное вещество (в лекарстве)", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Este jarabe lleva azúcar como excipiente.", "ru": "В этом сиропе вспомогательное вещество — сахар."}},
    {"id": "pharmacy.formula_magistral", "es": "la fórmula magistral", "ru": "лекарство, изготовленное в аптеке", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "La farmacéutica prepara una fórmula magistral para la piel.", "ru": "Фармацевт готовит для кожи лекарство по рецепту."}},
    {"id": "pharmacy.placebo", "es": "el placebo", "ru": "плацебо", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "La mitad de los pacientes tomó un placebo.", "ru": "Половина пациентов принимала плацебо."}},
    {"id": "pharmacy.homeopatia", "es": "la homeopatía", "ru": "гомеопатия", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "No hay pruebas de que la homeopatía funcione.", "ru": "Нет доказательств, что гомеопатия работает."}},
    {"id": "pharmacy.ansiolitico", "es": "el ansiolítico", "ru": "успокоительное (от тревоги)", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "El médico le recetó un ansiolítico suave.", "ru": "Врач выписал ему лёгкое успокоительное."}},
    {"id": "pharmacy.antidepresivo", "es": "el antidepresivo", "ru": "антидепрессант", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Los antidepresivos tardan semanas en hacer efecto.", "ru": "Антидепрессанты начинают действовать через несколько недель."}},
    {"id": "pharmacy.somnifero", "es": "el somnífero", "ru": "снотворное", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "No te acostumbres a los somníferos.", "ru": "Не привыкай к снотворному."}},
    {"id": "pharmacy.antihistaminico", "es": "el antihistamínico", "ru": "антигистаминное средство", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "En primavera tomo un antihistamínico por la alergia.", "ru": "Весной я пью антигистаминное от аллергии."}},
    {"id": "pharmacy.antiinflamatorio", "es": "el antiinflamatorio", "ru": "противовоспалительное", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Para la rodilla le dieron un antiinflamatorio.", "ru": "От колена ему дали противовоспалительное."}},
    {"id": "pharmacy.antiacido", "es": "el antiácido", "ru": "средство от изжоги", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Después de la cena necesitó un antiácido.", "ru": "После ужина ему понадобилось средство от изжоги."}},
    {"id": "pharmacy.antitermico", "es": "el antitérmico", "ru": "жаропонижающее", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Si la fiebre sube, dale un antitérmico.", "ru": "Если температура поднимется, дай жаропонижающее."}},
