    {"id": "pharmacy.gasa", "es": "la gasa", "ru": "марля, стерильная салфетка", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "Cubre la herida con una gasa limpia.", "ru": "Закрой рану чистой марлей."}},
    {"id": "pharmacy.esparadrapo", "es": "el esparadrapo", "ru": "пластырь (лента)", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Sujeta la gasa con esparadrapo.", "ru": "Закрепи марлю пластырем."}},
    {"id": "pharmacy.jeringuilla", "es": "la jeringuilla", "ru": "шприц", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "Las jeringuillas se tiran en un contenedor especial.", "ru": "Шприцы выбрасывают в специальный контейнер."}},
    {"id": "pharmacy.ampolla", "es": "la ampolla", "ru": "ампула; волдырь", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "Con los zapatos nuevos me salió una ampolla.", "ru": "От новых туфель у меня вскочил волдырь."}},
    {"id": "pharmacy.comprimido", "es": "el comprimido", "ru": "таблетка (прессованная)", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Tome un comprimido cada ocho horas.", "ru": "Принимайте по таблетке каждые восемь часов."}},
    {"id": "pharmacy.unguento", "es": "el ungüento", "ru": "мазь (густая)", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "La abuela tenía un ungüento para todo.", "ru": "У бабушки была мазь на все случаи."}},
