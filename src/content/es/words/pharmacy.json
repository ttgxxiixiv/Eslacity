    {"id": "pharmacy.dependencia", "es": "la dependencia", "ru": "зависимость", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "Algunos somníferos crean dependencia.", "ru": "Некоторые снотворные вызывают зависимость."}},
    {"id": "pharmacy.sobredosis", "es": "la sobredosis", "ru": "передозировка", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "Tomar el doble puede provocar una sobredosis.", "ru": "Двойная доза может вызвать передозировку."}},
    {"id": "pharmacy.nebulizador", "es": "el nebulizador", "ru": "ингалятор-небулайзер", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Para la bronquitis del niño usamos el nebulizador.", "ru": "При бронхите у ребёнка мы используем небулайзер."}},
    {"id": "pharmacy.tensiometro", "es": "el tensiómetro", "ru": "тонометр", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Me compré un tensiómetro para controlarme en casa.", "ru": "Я купил тонометр, чтобы следить за давлением дома."}},
    {"id": "pharmacy.ortopedia", "es": "la ortopedia", "ru": "ортопедические товары", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "Las muletas se compran en la ortopedia.", "ru": "Костыли продаются в магазине ортопедии."}},
    {"id": "pharmacy.pastillero", "es": "el pastillero", "ru": "таблетница", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Mi abuelo organiza las pastillas en un pastillero semanal.", "ru": "Дед раскладывает таблетки по таблетнице на неделю."}},
    {"id": "pharmacy.consulte_a_su_medico", "es": "consulte a su médico", "ru": "проконсультируйтесь с врачом", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "formula", "register": "formal", "pair": "pharmacy.preguntale_al_medico", "example": {"es": "Si los síntomas continúan, consulte a su médico.", "ru": "Если симптомы не проходят, проконсультируйтесь с врачом."}},
    {"id": "pharmacy.preguntale_al_medico", "es": "pregúntale al médico", "ru": "спроси у врача", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "formula", "register": "informal", "pair": "pharmacy.consulte_a_su_medico", "example": {"es": "No sé si puedes tomarlo con el café, pregúntale al médico.", "ru": "Не знаю, можно ли это с кофе, спроси у врача."}},
    {"id": "pharmacy.padecer_una_afeccion", "es": "padecer una afección", "ru": "страдать заболеванием", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "collocation", "register": "formal", "pair": "pharmacy.estar_pachucho", "example": {"es": "El paciente padece una afección respiratoria.", "ru": "Пациент страдает болезнью дыхательных путей."}},
    {"id": "pharmacy.estar_pachucho", "es": "estar pachucho", "ru": "прихворнуть", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "collocation", "register": "informal", "pair": "pharmacy.padecer_una_afeccion", "example": {"es": "Hoy no voy, estoy un poco pachucho.", "ru": "Сегодня не приду, я немного прихворнул."}},
    {"id": "pharmacy.que_se_mejore", "es": "que se mejore", "ru": "поправляйтесь", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "formula", "register": "formal", "pair": "pharmacy.ponte_bueno", "example": {"es": "Aquí tiene su jarabe. Que se mejore.", "ru": "Вот ваш сироп. Поправляйтесь."}},
    {"id": "pharmacy.ponte_bueno", "es": "¡ponte bueno!", "ru": "выздоравливай!", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "formula", "register": "informal", "pair": "pharmacy.que_se_mejore", "example": {"es": "Te llevo sopa luego. ¡Ponte bueno!", "ru": "Я потом занесу тебе супа. Выздоравливай!"}},
    {"id": "pharmacy.estar_hecho_un_trapo", "es": "estar hecho un trapo", "ru": "быть совсем без сил", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "informal", "literal": "быть превращённым в тряпку", "example": {"es": "Con la gripe estoy hecho un trapo.", "ru": "С гриппом я совсем без сил."}},
    {"id": "pharmacy.estar_como_un_roble", "es": "estar como un roble", "ru": "быть крепким как дуб", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "informal", "literal": "быть как дуб", "example": {"es": "Con ochenta años, mi abuelo está como un roble.", "ru": "В восемьдесят лет дед крепок как дуб."}},
    {"id": "pharmacy.pillar_un_resfriado", "es": "pillar un resfriado", "ru": "подхватить простуду", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "collocation", "register": "informal", "example": {"es": "Salí sin abrigo y pillé un resfriado.", "ru": "Я вышел без пальто и подхватил простуду."}},
    {"id": "pharmacy.tener_mal_cuerpo", "es": "tener mal cuerpo", "ru": "чувствовать себя разбитым", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "neutral", "literal": "иметь плохое тело", "example": {"es": "Desde ayer tengo mal cuerpo.", "ru": "Со вчерашнего дня я чувствую себя разбитым."}},
    {"id": "pharmacy.cada_ocho_horas", "es": "cada ocho horas", "ru": "каждые восемь часов", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "collocation", "register": "neutral", "example": {"es": "Tome el antibiótico cada ocho horas.", "ru": "Принимайте антибиотик каждые восемь часов."}},
    {"id": "pharmacy.curarse_en_salud", "es": "curarse en salud", "ru": "перестраховаться", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "neutral", "literal": "лечиться, будучи здоровым", "example": {"es": "Me pongo la vacuna para curarme en salud.", "ru": "Я делаю прививку, чтобы перестраховаться."}},
    {"id": "pharmacy.no_hay_mal_que_por_bien_no_venga", "es": "no hay mal que por bien no venga", "ru": "нет худа без добра", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "neutral", "literal": "нет зла, которое не пришло бы к добру", "example": {"es": "Me rompí la pierna y conocí a mi mujer: no hay mal que por bien no venga.", "ru": "Я сломал ногу и познакомился с женой: нет худа без добра."}},
    {"id": "pharmacy.a_la_larga", "es": "a la larga", "ru": "в долгосрочной перспективе", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "collocation", "register": "neutral", "example": {"es": "A la larga, automedicarse sale caro.", "ru": "В долгосрочной перспективе самолечение обходится дорого."}},
    {"id": "pharmacy.constipado", "es": "constipado", "ru": "простуженный", "pos": "adj", "level": 7, "cefr": "C1", "kind": "false-friend", "register": "neutral", "note": "Не страдающий запором. Estar constipado — быть простуженным, с насморком. Запор — el estreñimiento.", "example": {"es": "Estoy constipado y no paro de estornudar.", "ru": "Я простужен и всё время чихаю."}}
  ]
