    {"id": "cafe.abarrotado", "es": "abarrotado", "ru": "битком набитый", "pos": "adj", "level": 6, "cefr": "B2", "example": {"es": "A las nueve la cafetería está abarrotada.", "ru": "В девять кафе набито битком."}},
    {"id": "cafe.bullicio", "es": "el bullicio", "ru": "шум, гомон (людей)", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Me gusta el bullicio de la cafetería por la mañana.", "ru": "Мне нравится утренний гомон в кафе."}},
    {"id": "cafe.paciencia", "es": "la paciencia", "ru": "терпение", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "Gracias por su paciencia, ya viene su café.", "ru": "Спасибо за терпение, ваш кофе уже несут."}},
    {"id": "cafe.impaciente", "es": "impaciente", "ru": "нетерпеливый", "pos": "adj", "level": 6, "cefr": "B2", "example": {"es": "Los clientes empiezan a ponerse impacientes.", "ru": "Посетители начинают терять терпение."}},
    {"id": "cafe.malentendido", "es": "el malentendido", "ru": "недоразумение", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Ha sido un malentendido: yo pedí un cortado.", "ru": "Вышло недоразумение: я заказывал кортадо."}},
    {"id": "cafe.despiste", "es": "el despiste", "ru": "оплошность по рассеянности", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Perdone, ha sido un despiste mío.", "ru": "Простите, это я по рассеянности."}},
    {"id": "cafe.molestia", "es": "la molestia", "ru": "беспокойство, неудобство", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "Disculpe las molestias, estamos limpiando la barra.", "ru": "Простите за неудобство, мы протираем стойку."}},
    {"id": "cafe.clientela", "es": "la clientela", "ru": "клиентура, посетители", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "La clientela del café es sobre todo gente mayor.", "ru": "Посетители кафе в основном пожилые люди."}},
    {"id": "cafe.fiel", "es": "fiel", "ru": "верный, постоянный", "pos": "adj", "level": 6, "cefr": "B2", "example": {"es": "Es un cliente fiel desde hace veinte años.", "ru": "Он постоянный клиент уже двадцать лет."}},
    {"id": "cafe.local", "es": "el local", "ru": "заведение", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Este local abrió sus puertas en 1920.", "ru": "Это заведение открылось в 1920 году."}},
    {"id": "cafe.ronda", "es": "la ronda", "ru": "круг (угощение для всей компании)", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "Esta ronda la pago yo.", "ru": "Этот круг за мной."}},
    {"id": "cafe.desahogarse", "es": "desahogarse", "ru": "выговориться", "pos": "verb", "level": 6, "cefr": "B2", "example": {"es": "Necesitaba desahogarme con alguien.", "ru": "Мне нужно было кому-нибудь выговориться."}},
    {"id": "cafe.cotilleo", "es": "el cotilleo", "ru": "сплетня", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "En la barra siempre hay algún cotilleo.", "ru": "У стойки всегда обсуждают какую-нибудь сплетню."}},
    {"id": "cafe.cotillear", "es": "cotillear", "ru": "сплетничать", "pos": "verb", "level": 6, "cefr": "B2", "example": {"es": "Dejad de cotillear sobre los vecinos.", "ru": "Хватит сплетничать о соседях."}},
    {"id": "cafe.anecdota", "es": "la anécdota", "ru": "забавный случай из жизни", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "Mi abuelo siempre cuenta la misma anécdota.", "ru": "Дедушка всегда рассказывает одну и ту же историю."}},
    {"id": "cafe.sincerarse", "es": "sincerarse", "ru": "откровенно рассказать, открыться", "pos": "verb", "level": 6, "cefr": "B2", "example": {"es": "Por fin se sinceró conmigo y me contó el problema.", "ru": "Наконец он открылся мне и рассказал о своей проблеме."}},
    {"id": "cafe.teletrabajar", "es": "teletrabajar", "ru": "работать удалённо", "pos": "verb", "level": 6, "cefr": "B2", "example": {"es": "Muchos vienen aquí a teletrabajar con el portátil.", "ru": "Многие приходят сюда поработать удалённо с ноутбуком."}},
    {"id": "cafe.nostalgia", "es": "la nostalgia", "ru": "ностальгия", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "Este café me da nostalgia de mi juventud.", "ru": "Это кафе вызывает у меня ностальгию по молодости."}},
    {"id": "cafe.encuentro", "es": "el encuentro", "ru": "встреча", "pos": "noun", "gender": "m", "level": 6, "cefr": "B2", "example": {"es": "Fue un encuentro inesperado con una vieja amiga.", "ru": "Это была неожиданная встреча со старой подругой."}},
    {"id": "cafe.inesperado", "es": "inesperado", "ru": "неожиданный", "pos": "adj", "level": 6, "cefr": "B2", "example": {"es": "Recibí una visita inesperada en el café.", "ru": "В кафе ко мне пришёл неожиданный гость."}},
    {"id": "cafe.cafeina", "es": "la cafeína", "ru": "кофеин", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "Por la tarde evito la cafeína.", "ru": "После обеда я избегаю кофеина."}},
    {"id": "cafe.leche_de_avena", "es": "la leche de avena", "ru": "овсяное молоко", "pos": "noun", "gender": "f", "level": 6, "cefr": "B2", "example": {"es": "¿Tienen leche de avena para el café?", "ru": "У вас есть овсяное молоко к кофе?"}},
    {"id": "cafe.tueste", "es": "el tueste", "ru": "обжарка (кофе)", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Este café tiene un tueste suave.", "ru": "У этого кофе мягкая обжарка."}},
    {"id": "cafe.paladar", "es": "el paladar", "ru": "вкус, нёбо", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Tiene un paladar muy fino para el café.", "ru": "У него очень тонкий вкус к кофе."}},
    {"id": "cafe.regusto", "es": "el regusto", "ru": "послевкусие", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Deja un regusto amargo muy agradable.", "ru": "Оставляет очень приятное горьковатое послевкусие."}},
    {"id": "cafe.molienda", "es": "la molienda", "ru": "помол", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "Para la cafetera italiana hace falta una molienda media.", "ru": "Для гейзерной кофеварки нужен средний помол."}},
    {"id": "cafe.contertulio", "es": "el contertulio", "ru": "участник беседы, завсегдатай", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Los contertulios del jueves discuten de política.", "ru": "Завсегдатаи четверговых посиделок спорят о политике."}},
    {"id": "cafe.confidencia", "es": "la confidencia", "ru": "признание, доверенный секрет", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "Me hizo una confidencia que no puedo contar.", "ru": "Он доверил мне секрет, который я не могу рассказать."}},
    {"id": "cafe.desahogo", "es": "el desahogo", "ru": "отдушина", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Estas charlas son mi desahogo de la semana.", "ru": "Эти разговоры — моя отдушина за неделю."}},
    {"id": "cafe.complicidad", "es": "la complicidad", "ru": "взаимопонимание, заговорщицкая близость", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "Entre ellas hay una complicidad de años.", "ru": "Между ними многолетнее взаимопонимание."}},
    {"id": "cafe.franqueza", "es": "la franqueza", "ru": "откровенность, прямота", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "Te lo digo con toda franqueza.", "ru": "Говорю тебе совершенно откровенно."}},
    {"id": "cafe.indirecta", "es": "la indirecta", "ru": "намёк, шпилька", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "Eso fue una indirecta para mí, ¿verdad?", "ru": "Это был намёк в мой адрес, да?"}},
    {"id": "cafe.reproche", "es": "el reproche", "ru": "упрёк", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "No quiero reproches, solo una explicación.", "ru": "Мне не нужны упрёки, только объяснение."}},
    {"id": "cafe.reconciliacion", "es": "la reconciliación", "ru": "примирение", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "La reconciliación llegó con un café y un abrazo.", "ru": "Примирение случилось за чашкой кофе и с объятием."}},
    {"id": "cafe.rencilla", "es": "la rencilla", "ru": "размолвка, мелкая ссора", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "Las rencillas entre vecinos se arreglan con un café.", "ru": "Размолвки между соседями улаживаются за чашкой кофе."}},
    {"id": "cafe.parroquiano", "es": "el parroquiano", "ru": "завсегдатай (заведения)", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Los parroquianos tienen su mesa de siempre.", "ru": "У завсегдатаев свой постоянный столик."}},
    {"id": "cafe.penumbra", "es": "la penumbra", "ru": "полумрак", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "example": {"es": "Por la tarde el local queda en penumbra.", "ru": "Вечером в заведении полумрак."}},
    {"id": "cafe.ventanal", "es": "el ventanal", "ru": "большое окно, витрина", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Me siento junto al ventanal para ver la plaza.", "ru": "Я сажусь у большого окна, чтобы видеть площадь."}},
    {"id": "cafe.hogareno", "es": "hogareño", "ru": "домашний, уютный", "pos": "adj", "level": 7, "cefr": "C1", "example": {"es": "El café tiene un ambiente hogareño.", "ru": "В кафе домашняя обстановка."}},
    {"id": "cafe.entranable", "es": "entrañable", "ru": "милый сердцу, душевный", "pos": "adj", "level": 7, "cefr": "C1", "example": {"es": "El dueño es un señor entrañable.", "ru": "Хозяин — очень душевный человек."}},
    {"id": "cafe.efimero", "es": "efímero", "ru": "мимолётный", "pos": "adj", "level": 7, "cefr": "C1", "example": {"es": "Fue un encuentro efímero pero intenso.", "ru": "Встреча была мимолётной, но яркой."}},
    {"id": "cafe.anorar", "es": "añorar", "ru": "тосковать (по прошлому)", "pos": "verb", "level": 7, "cefr": "C1", "example": {"es": "Añoro las tardes en aquel café de estudiantes.", "ru": "Я тоскую по вечерам в том студенческом кафе."}},
    {"id": "cafe.evocar", "es": "evocar", "ru": "вызывать в памяти", "pos": "verb", "level": 7, "cefr": "C1", "example": {"es": "Este olor me evoca la casa de mi abuela.", "ru": "Этот запах напоминает мне бабушкин дом."}},
    {"id": "cafe.matizar", "es": "matizar", "ru": "уточнять, смягчать (сказанное)", "pos": "verb", "level": 7, "cefr": "C1", "example": {"es": "Déjame matizar lo que dije antes.", "ru": "Позволь уточнить то, что я сказал раньше."}},
    {"id": "cafe.divagar", "es": "divagar", "ru": "отвлекаться от темы", "pos": "verb", "level": 7, "cefr": "C1", "example": {"es": "Perdona, estoy divagando otra vez.", "ru": "Прости, я опять отвлёкся от темы."}},
    {"id": "cafe.saborear", "es": "saborear", "ru": "смаковать", "pos": "verb", "level": 7, "cefr": "C1", "example": {"es": "Me gusta saborear el primer café del día.", "ru": "Люблю смаковать первый кофе за день."}},
    {"id": "cafe.sorbo", "es": "el sorbo", "ru": "глоток", "pos": "noun", "gender": "m", "level": 7, "cefr": "C1", "example": {"es": "Bebió un sorbo y sonrió.", "ru": "Он сделал глоток и улыбнулся."}},
    {"id": "cafe.desea_tomar_algo_mas", "es": "¿Desea tomar algo más?", "ru": "желаете что-нибудь ещё?", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "formula", "register": "formal", "pair": "cafe.te_pongo_otra", "example": {"es": "¿Desea tomar algo más, señora?", "ru": "Желаете что-нибудь ещё, сеньора?"}},
    {"id": "cafe.te_pongo_otra", "es": "¿Te pongo otra?", "ru": "тебе повторить?", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "formula", "register": "informal", "pair": "cafe.desea_tomar_algo_mas", "example": {"es": "Se te ha acabado la caña, ¿te pongo otra?", "ru": "У тебя пиво кончилось, повторить?"}},
    {"id": "cafe.me_permite", "es": "¿Me permite?", "ru": "разрешите? (присесть, взять)", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "formula", "register": "formal", "pair": "cafe.hay_hueco", "example": {"es": "¿Me permite? Todas las mesas están ocupadas.", "ru": "Разрешите? Все столики заняты."}},
    {"id": "cafe.hay_hueco", "es": "¿Hay hueco?", "ru": "найдётся местечко?", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "formula", "register": "informal", "pair": "cafe.me_permite", "example": {"es": "Somos cinco, ¿hay hueco para nosotros?", "ru": "Нас пятеро, найдётся для нас местечко?"}},
    {"id": "cafe.permitame_invitarle", "es": "permítame invitarle", "ru": "позвольте вас угостить", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "formula", "register": "formal", "pair": "cafe.esta_ronda_la_pago_yo", "example": {"es": "Permítame invitarle a un café, por favor.", "ru": "Позвольте угостить вас кофе."}},
    {"id": "cafe.esta_ronda_la_pago_yo", "es": "esta ronda la pago yo", "ru": "этот круг за мной", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "formula", "register": "informal", "pair": "cafe.permitame_invitarle", "example": {"es": "Guarda la cartera, esta ronda la pago yo.", "ru": "Убери кошелёк, этот круг за мной."}},
    {"id": "cafe.matar_el_rato", "es": "matar el rato", "ru": "коротать время", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "informal", "literal": "убить время", "example": {"es": "Leo el periódico para matar el rato.", "ru": "Я читаю газету, чтобы скоротать время."}},
    {"id": "cafe.ponerse_al_dia", "es": "ponerse al día", "ru": "обменяться новостями, наверстать", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "collocation", "register": "neutral", "example": {"es": "Quedamos para ponernos al día.", "ru": "Мы встретились, чтобы обменяться новостями."}},
    {"id": "cafe.irse_por_las_ramas", "es": "irse por las ramas", "ru": "уходить от темы", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "informal", "literal": "уйти по веткам", "example": {"es": "No te vayas por las ramas y dime qué pasó.", "ru": "Не уходи от темы и скажи, что случилось."}},
    {"id": "cafe.tirar_de_la_lengua", "es": "tirar de la lengua", "ru": "вытягивать секреты", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "informal", "literal": "тянуть за язык", "example": {"es": "Me tiró de la lengua hasta que se lo conté todo.", "ru": "Он выпытывал у меня, пока я всё не рассказал."}},
    {"id": "cafe.quedarse_de_piedra", "es": "quedarse de piedra", "ru": "остолбенеть", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "informal", "literal": "остаться каменным", "example": {"es": "Cuando lo vi entrar, me quedé de piedra.", "ru": "Когда я увидел, как он входит, я остолбенел."}},
    {"id": "cafe.no_pegar_ojo", "es": "no pegar ojo", "ru": "не сомкнуть глаз", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "informal", "literal": "не приклеить глаз", "example": {"es": "Con tanto café no pude pegar ojo en toda la noche.", "ru": "От такого количества кофе я всю ночь не мог сомкнуть глаз."}},
    {"id": "cafe.estar_en_las_nubes", "es": "estar en las nubes", "ru": "витать в облаках", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "neutral", "literal": "быть в облаках", "example": {"es": "Perdona, estaba en las nubes. ¿Qué decías?", "ru": "Прости, я витал в облаках. Что ты говорил?"}},
    {"id": "cafe.hablar_por_los_codos", "es": "hablar por los codos", "ru": "болтать без умолку", "pos": "phrase", "level": 7, "cefr": "C1", "kind": "idiom", "register": "informal", "literal": "говорить локтями", "example": {"es": "Mi vecina habla por los codos.", "ru": "Моя соседка болтает без умолку."}},
    {"id": "cafe.torta", "es": "la torta", "ru": "лепёшка, плоский пирог", "pos": "noun", "gender": "f", "level": 7, "cefr": "C1", "kind": "false-friend", "register": "neutral", "note": "Не торт. В Испании la torta — лепёшка или плоский пирог (а в разговоре ещё и оплеуха). Торт — la tarta.", "example": {"es": "Con el café pedimos una torta de aceite.", "ru": "К кофе мы взяли лепёшку на оливковом масле."}}
  ]
