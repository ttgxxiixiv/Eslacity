            "hei",
            "Hei de encontrar o caminho."
          ]
        },
        {
          "cells": [
            "você / ele",
            "há",
            "Há de dar certo."
          ]
        },
        {
          "cells": [
            "nós",
            "havemos",
            "Havemos de vencer."
          ]
        },
        {
          "cells": [
            "eles",
            "hão",
            "Eles hão de entender."
          ]
        }
      ]
    },
    {
      "kind": "tip",
      "md": "**Ter de** и **ter que** — «должен»: **tenho de ir**, разговорное **tenho que ir**. **Haver de** — не долг, а уверенность."
    }
  ],
