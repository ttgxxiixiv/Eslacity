            "te / o, a"
          ]
        },
        {
          "cells": [
            "его, её",
            "ele, ela",
            "o, a"
          ]
        },
        {
          "cells": [
            "нас",
            "nos / a gente",
            "nos"
          ]
        },
        {
          "cells": [
            "их",
