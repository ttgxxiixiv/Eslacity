{
  "id": "a1.29-would-like",
  "district": "A1",
  "order": 29,
  "title": "Would like: хотел бы",
  "theory": [
    {
      "kind": "text",
      "md": "**Would like** — вежливое «хотел бы»: I**’d like** a coffee, please. Вопрос-предложение: **Would you like** some tea?"
    },
    {
      "kind": "text",
      "md": "После would like — существительное или **to + глагол**: I’d like **to** book a table."
    },
    {
      "kind": "tip",
      "md": "**I want** звучит резко, в кафе и магазине говорят **I'd like**."
    }
  ],
  "examples": [
    {
      "es": "I'd like a cup of tea, please.",
      "ru": "Мне, пожалуйста, чашку чая."
    },
    {
      "es": "Would you like some cake?",
      "ru": "Не хотите торта?"
    },
    {
      "es": "I'd like to book a room.",
      "ru": "Я хотел бы забронировать номер."
    },
    {
      "es": "Yes, I'd love to!",
      "ru": "Да, с удовольствием!"
    }
  ],
