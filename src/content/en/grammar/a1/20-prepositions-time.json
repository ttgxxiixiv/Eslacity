{
  "id": "a1.20-prepositions-time",
  "district": "A1",
  "order": 20,
  "title": "Предлоги времени: at, on, in",
  "theory": [
    {
      "kind": "text",
      "md": "**At** — с часами и моментами: at six, at night, at the weekend. **On** — с днями и датами: on Monday, on 5 May. **In** — с месяцами, годами, временами года, частями дня: in May, in 2026, in winter, in the morning."
    },
    {
      "kind": "table",
      "head": [
        "Предлог",
        "Когда",
        "Пример"
      ],
      "rows": [
        {
          "cells": [
            "at",
            "время, момент",
            "at 7 o’clock, at night"
          ]
        },
        {
          "cells": [
            "on",
            "день, дата",
            "on Friday, on my birthday"
          ]
        },
        {
          "cells": [
            "in",
            "месяц, год, сезон, часть дня",
            "in June, in the evening"
          ]
        },
        {
          "cells": [
            "until",
            "до какого-то момента",
            "until six"
          ]
        },
        {
          "cells": [
            "from … to",
            "с … до",
            "from nine to five"
          ]
        }
      ]
    },
    {
      "kind": "tip",
      "md": "Без предлога: today, tomorrow, yesterday, next week, last year, every day."
    }
  ],
  "examples": [
    {
      "es": "The museum opens at nine.",
      "ru": "Музей открывается в девять."
    },
    {
      "es": "I'm free on Saturday.",
