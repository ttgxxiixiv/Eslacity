  "order": 26,
  "title": "Me, him, her, us, them",
  "theory": [
    {
      "kind": "text",
      "md": "После глагола и предлога местоимение меняет форму: **I** → **me**, **he** → **him**, **she** → **her**, **we** → **us**, **they** → **them**. **You** и **it** не меняются."
    },
    {
      "kind": "table",
      "head": [
        "Подлежащее",
        "После глагола"
      ],
      "rows": [
        {
          "cells": [
            "I",
            "me"
          ]
        },
        {
          "cells": [
            "you",
            "you"
          ]
        },
        {
          "cells": [
            "he",
            "him"
          ]
        },
        {
          "cells": [
            "she",
            "her"
          ]
        },
        {
          "cells": [
            "it",
            "it"
          ]
        },
        {
          "cells": [
            "we",
            "us"
          ]
        },
        {
          "cells": [
            "they",
            "them"
          ]
        }
      ]
    },
    {
      "kind": "tip",
      "md": "Call me! — Позвони мне! I love them. — Я их люблю. Come with us. — Пойдём с нами."
    }
  ],
  "examples": [
    {
      "es": "Can you help me?",
      "ru": "Ты можешь мне помочь?"
    },
    {
      "es": "I see him every day.",
      "ru": "Я вижу его каждый день."
    },
    {
      "es": "This is for you.",
      "ru": "Это для тебя."
    },
    {
      "es": "We know them well.",
      "ru": "Мы хорошо их знаем."
    }
  ],
