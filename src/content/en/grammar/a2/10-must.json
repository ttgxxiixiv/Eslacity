{
  "id": "a2.10-must",
  "district": "A2",
  "order": 10,
  "title": "Must и mustn’t",
  "theory": [
    {
      "kind": "text",
      "md": "**Must** — «должен, обязательно» (часто по своему решению или правилу): I **must** call my mum. **Mustn’t** — «нельзя»: You **mustn’t** smoke here."
    },
    {
      "kind": "text",
      "md": "После must — глагол без to и без -s: She must go."
    },
    {
      "kind": "tip",
      "md": "Mustn't — запрет, а не «не обязательно». «Не обязательно» — don't have to (следующий урок)."
    }
  ],
  "examples": [
    {
      "es": "I must finish this today.",
      "ru": "Я должен закончить это сегодня."
    },
    {
      "es": "You mustn't swim here.",
      "ru": "Здесь нельзя плавать."
    },
    {
      "es": "Passengers must show their tickets.",
      "ru": "Пассажиры должны показать билеты."
    },
    {
      "es": "We must hurry!",
      "ru": "Нам надо спешить!"
    }
  ],
