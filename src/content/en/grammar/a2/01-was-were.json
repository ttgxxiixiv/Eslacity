  "theory": [
    {
      "kind": "text",
      "md": "Прошедшее от to be: **was** — с I, he, she, it; **were** — с you, we, they. Yesterday **was** cold. We **were** at the beach."
    },
    {
      "kind": "table",
      "head": [
        "",
        "Утверждение",
        "Отрицание",
        "Вопрос"
      ],
      "rows": [
        {
          "cells": [
            "I, he, she, it",
            "was",
            "wasn't",
            "Was he…?"
          ]
        },
        {
          "cells": [
            "you, we, they",
            "were",
            "weren't",
            "Were you…?"
          ]
        }
      ]
    },
    {
      "kind": "tip",
      "md": "Слова-подсказки: yesterday, last week, in 2020, ago, then."
    }
  ],
  "examples": [
