{
  "id": "a2.15-present-perfect",
  "district": "A2",
  "order": 15,
  "title": "Present Perfect: образование",
  "theory": [
    {
      "kind": "text",
      "md": "**Present Perfect** — **have / has + третья форма глагола** (причастие). Он связывает прошлое с настоящим: важен результат сейчас. I **have lost** my key (и сейчас ключа нет)."
    },
    {
      "kind": "table",
      "head": [
        "Лицо",
        "Форма"
      ],
      "rows": [
        {
          "cells": [
            "I, you, we, they",
            "have (’ve) seen"
          ]
        },
        {
          "cells": [
            "he, she, it",
            "has (’s) seen"
          ]
        },
        {
          "cells": [
            "Отрицание",
            "haven't / hasn't seen"
          ]
        },
        {
          "cells": [
            "Вопрос",
            "Have you seen…?"
          ]
        }
      ]
    },
    {
      "kind": "tip",
      "md": "У правильных глаголов третья форма = прошедшее: worked. У неправильных своя: go → gone, see → seen, be → been, do → done."
    }
  ],
  "examples": [
    {
      "es": "I've lost my wallet.",
      "ru": "Я потерял бумажник."
    },
    {
      "es": "She has finished her work.",
      "ru": "Она закончила работу."
    },
    {
      "es": "Have you seen my keys?",
      "ru": "Ты не видел мои ключи?"
    },
    {
      "es": "They haven't arrived yet.",
      "ru": "Они ещё не приехали."
    }
  ],
