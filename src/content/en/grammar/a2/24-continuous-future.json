{
  "id": "a2.24-continuous-future",
  "district": "A2",
  "order": 24,
  "title": "Present Continuous для планов",
  "theory": [
    {
      "kind": "text",
      "md": "Договорённость на будущее с точным временем — **Present Continuous**: I**’m meeting** Tom at six. We**’re flying** to Spain on Friday."
    },
    {
      "kind": "text",
      "md": "Going to — намерение, Continuous — уже договорились, купили билеты, назначили встречу."
    },
    {
      "kind": "tip",
      "md": "Обязательно слово о будущем: tomorrow, on Friday, next week, tonight."
    }
  ],
  "examples": [
    {
      "es": "I'm seeing the doctor tomorrow.",
      "ru": "Завтра я иду к врачу."
    },
    {
      "es": "We're having a party on Saturday.",
      "ru": "В субботу у нас вечеринка."
    },
    {
      "es": "What are you doing tonight?",
      "ru": "Что ты делаешь сегодня вечером?"
    },
    {
      "es": "She's leaving next week.",
      "ru": "Она уезжает на следующей неделе."
    }
  ],
