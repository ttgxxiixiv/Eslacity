{
  "id": "a2.23-verb-ing",
  "district": "A2",
  "order": 23,
  "title": "Enjoy, finish, stop + -ing",
  "theory": [
    {
      "kind": "text",
      "md": "После **enjoy**, **finish**, **stop**, **mind**, **keep**, **go** (о занятиях) действие стоит с **-ing**: I enjoy **reading**. She finished **cooking**. Let’s **go swimming**!"
    },
    {
      "kind": "table",
      "head": [
        "Глагол",
        "Пример"
      ],
      "rows": [
        {
          "cells": [
            "enjoy",
            "We enjoyed walking."
          ]
        },
        {
          "cells": [
            "finish",
            "Have you finished eating?"
          ]
        },
        {
          "cells": [
            "stop",
            "Stop talking!"
          ]
        },
        {
          "cells": [
            "mind",
            "Do you mind waiting?"
          ]
        },
        {
          "cells": [
            "go + -ing",
            "go shopping, go fishing"
          ]
        }
      ]
    },
    {
      "kind": "tip",
      "md": "**Do you mind…?** — вежливое «Вы не против…?»: Do you mind opening the window?"
    }
  ],
  "examples": [
    {
      "es": "I enjoy cooking for friends.",
      "ru": "Я люблю готовить для друзей."
    },
    {
      "es": "Stop worrying!",
      "ru": "Хватит волноваться!"
    },
    {
      "es": "Let's go fishing tomorrow.",
      "ru": "Давай завтра пойдём на рыбалку."
    },
    {
      "es": "Do you mind closing the door?",
      "ru": "Вы не против закрыть дверь?"
    }
  ],
